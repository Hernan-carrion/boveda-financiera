# Sincronización opcional con Supabase.
# Copiá este archivo a .env.local y completá con los valores de tu proyecto
# (Supabase → Project Settings → API). Si estos valores no están definidos,
# la app sigue funcionando 100% local (IndexedDB) y los botones de sync quedan
# deshabilitados.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Notificaciones push de recordatorios (opcional). La clave pública de VAPID
# no es secreta — generá el par con `npx web-push generate-vapid-keys` y
# pegá acá solo la pública. La privada va como secret de la Edge Function de
# Supabase (ver supabase/functions/send-recordatorios/README.md), nunca acá.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY
